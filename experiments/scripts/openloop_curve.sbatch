#!/bin/bash
#SBATCH --account=def-hpcg1971_gpu
#SBATCH --gres=gpu:1
#SBATCH --exclusive
#SBATCH --cpus-per-task=16
#SBATCH --mem=48G
#SBATCH --time=04:00:00
#SBATCH --job-name=olc-curve
#SBATCH --output=%x-%j.out
# OPEN-LOOP Stage 1 curve: one GPU, one vLLM, Poisson arrivals at fixed rates.
#
# Why (audit 2026-10-09, plan 12.14d; author chose approach A). Closed-loop
# sweeps (h1_sweep) hold concurrency fixed and cannot see queueing. Under
# Poisson arrivals near vLLM's 256-request batch limit, requests wait for a
# slot (TTFT p50 1.44 s on the mixed fleet against 0.05 s in Stage 2), and the
# closed-loop curve called that 1.4 s end to end. This job measures what the
# router faces: for each arrival rate, the mean number in flight (Little's
# law), the p95 latency, tokens/s and power.
#
# The load is generated by policy_harness.py itself (one endpoint,
# round_robin), the same verified instrument, prompts and streaming as Stage
# 2/5. vLLM runs with the Stage 2 configuration (max-model-len 2048) and its
# batch limits PINNED to the defaults it picked implicitly before:
#   --max-num-seqs 256 --max-num-batched-tokens 2048
# These are vLLM 0.30.0's defaults for GPUs under 70 GB (arg_utils.py
# get_batch_defaults); pinning them stops a future default change from
# silently changing the experiment.
#
# Knobs: RATES (comma list, req/s, ascending), TRIALS (trial 1 is warm-up),
# DURATION (s per cell), WORKERS, SEED, MODEL.
if ! command -v module >/dev/null 2>&1; then
  source /cvmfs/soft.computecanada.ca/config/profile/bash.sh 2>/dev/null || source ${LMOD_PKG:-/cvmfs/soft.computecanada.ca/custom/software/lmod/lmod}/init/bash 2>/dev/null
fi
module load apptainer/1.4.5 2>/dev/null || module load apptainer 2>/dev/null
APPTAINER=$(command -v apptainer || echo /cvmfs/soft.computecanada.ca/easybuild/software/2023/x86-64-v3/Core/apptainer/1.4.5/bin/apptainer)
"$APPTAINER" --version >/dev/null || { echo "FATAL: no apptainer"; exit 1; }
set -u

ROOT=~/energy-epp
RUN=$ROOT/results/olc-$SLURM_JOB_ID
mkdir -p "$RUN"
IMG="$ROOT/images/vllm-v0.30.0.sif"
MODEL=${MODEL:-Qwen/Qwen2.5-1.5B-Instruct}
RATES=${RATES:?set RATES, e.g. 4,9,18}
TRIALS=${TRIALS:-6}
DURATION=${DURATION:-60}
WORKERS=${WORKERS:-6}
SEED=${SEED:-701}
# vLLM batch limits. Default = vLLM 0.30.0's own defaults for GPUs under
# 70 GB (the Stage 5 configuration). The sensitivity study overrides them.
MAX_NUM_SEQS=${MAX_NUM_SEQS:-256}
MAX_BATCHED=${MAX_BATCHED:-2048}
export HF_HOME=${HF_HOME:-$ROOT/.hf}
CPY="env -u SSL_CERT_FILE $APPTAINER exec --nv $IMG python3"
GPU_NAME="$(nvidia-smi --query-gpu=name --format=csv,noheader | head -1 | tr ' ' '_')"

{
  echo "node=$(hostname) job=$SLURM_JOB_ID kind=openloop"
  echo "model=$MODEL rates=$RATES duration=$DURATION trials=$TRIALS seed=$SEED workers=$WORKERS"
  echo "vllm_args=--max-model-len 2048 --max-num-seqs $MAX_NUM_SEQS --max-num-batched-tokens $MAX_BATCHED --gpu-memory-utilization 0.85"
  nvidia-smi --query-gpu=index,uuid,name,driver_version,power.limit,power.min_limit,power.max_limit,memory.total,persistence_mode --format=csv
  echo "kernel=$(uname -r)"
  echo "rm_profiling_admin_only=$(grep -oE 'RmProfilingAdminOnly: [0-9]+' /proc/driver/nvidia/params 2>/dev/null | awk '{print $2}' || echo NA)"
  echo "slurm_constraint=${SLURM_JOB_CONSTRAINTS:-none} exclusive=${SLURM_JOB_NUM_NODES:-?}node cpus=${SLURM_CPUS_PER_TASK:-?}"
  echo "cotenants_at_start:"
  nvidia-smi --query-compute-apps=pid,used_memory --format=csv
  "$APPTAINER" exec $IMG python3 -c "import vllm,torch;print('vllm',vllm.__version__,'torch',torch.__version__)"
} | tee "$RUN/instruments.txt"

CUDA_VISIBLE_DEVICES=0 env -u SSL_CERT_FILE "$APPTAINER" exec --nv "$IMG" \
  vllm serve "$MODEL" --served-model-name served --host 127.0.0.1 --port 8100 \
    --gpu-memory-utilization 0.85 --max-model-len 2048 \
    --max-num-seqs "$MAX_NUM_SEQS" --max-num-batched-tokens "$MAX_BATCHED" \
    > "$RUN/vllm.log" 2>&1 &
VLLM=$!
trap 'kill $VLLM 2>/dev/null' EXIT
for t in $(seq 1 90); do
  curl -sf http://127.0.0.1:8100/v1/models >/dev/null && { echo "vllm up after ${t}0s"; break; }
  sleep 10
done
curl -sf http://127.0.0.1:8100/v1/models >/dev/null || { echo "FATAL: vllm never came up"; tail -20 "$RUN/vllm.log"; exit 1; }
# The pinned limits must be what vLLM actually uses, not just what we asked.
grep -qE "max_num_seqs.{0,4}${MAX_NUM_SEQS}" "$RUN/vllm.log" && grep -qE "max_num_batched_tokens.{0,4}${MAX_BATCHED}" "$RUN/vllm.log" \
  && echo "vllm limits confirmed in its own log" \
  || { echo "FATAL: vllm log does not confirm max_num_seqs=256 and max_num_batched_tokens=2048"; exit 1; }

# Idle power with the model resident, read from the energy counter.
$CPY - <<'PY' | tee "$RUN/idle.txt"
import pynvml as n, time
n.nvmlInit(); h = n.nvmlDeviceGetHandleByIndex(0)
e0 = n.nvmlDeviceGetTotalEnergyConsumption(h); t0 = time.time()
time.sleep(30)
e1 = n.nvmlDeviceGetTotalEnergyConsumption(h); t1 = time.time()
print(f"{(e1-e0)/1000/(t1-t0):.2f}")
PY

IFS=',' read -ra RATE_ARR <<< "$RATES"
for t in $(seq 1 "$TRIALS"); do
  for rate in "${RATE_ARR[@]}"; do
    n_req="$(python3 -c "import math;print(max(100, math.ceil($rate * $DURATION)))")"
    echo "=== trial $t rate $rate req/s, $n_req requests ==="
    # A client-limited cell exits nonzero after writing its JSON. Keep going:
    # openloop_build.py records the flag and the loader ends the curve there.
    $CPY "$ROOT/scripts/policy_harness.py" \
      --endpoints 127.0.0.1:8100 --gpus 0 --endpoint-types "$GPU_NAME" \
      --policies round_robin --rate "$rate" --requests "$n_req" --slo 2.0 \
      --workers "$WORKERS" --scratch "$RUN" --seed "$((SEED + t))" \
      --out "$RUN/olc-trial${t}-rate${rate}.json" 2>&1 | tee -a "$RUN/harness.log" \
      || echo "  (harness exited nonzero at rate $rate; kept)"
  done
done

$CPY "$ROOT/scripts/openloop_build.py" "$RUN" 2>&1 | tee -a "$RUN/harness.log"
echo "results in $RUN"
exit 0
